{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-thumbnail-maker",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist"
  },
  // カスタムドメイン設定後に workers_dev を false にして重複公開を止める。
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
